# name: test/sql/buffering.test
# description: Ordered table-buffering detector interfaces
# group: [vgi_anomaly]

require-env VGI_ANOMALY_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'anomaly' AS anomaly (TYPE vgi, LOCATION '{VGI_ANOMALY_WORKER}');

statement ok
SET threads=4;

# Cross several input chunks with a multithreaded host; preserve the full input.
statement ok
CREATE TABLE readings AS SELECT i AS ts, CASE WHEN i = 4500 THEN 100.0 ELSE 0.0 END AS value FROM range(5000) t(i);

query I
SELECT * FROM anomaly.zscore_anomalies((SELECT value FROM readings ORDER BY ts));
----
4500

# Reverse ordering changes the zero-based position, regardless of physical order.
query I
SELECT * FROM anomaly.zscore_anomalies((SELECT value FROM readings ORDER BY ts DESC), threshold := 3.0);
----
499

query I
SELECT * FROM anomaly.change_points((SELECT CASE WHEN i < 30 THEN 0.0 ELSE 10.0 END FROM range(60) t(i) ORDER BY i));
----
30

query I
SELECT * FROM anomaly.change_points((SELECT CASE WHEN i < 30 THEN 0.0 ELSE 10.0 END FROM range(60) t(i) ORDER BY i), n_bkps := 1);
----
30

query I
SELECT count(*) FROM anomaly.matrix_profile((SELECT i::DOUBLE FROM range(10) t(i) ORDER BY i), window_size := 4);
----
7

# All table functions can coexist with the original same-named scalars.
query I
SELECT "index" = anomaly.discord_index(range(10)::DOUBLE[], 4)
FROM anomaly.discord_index((SELECT i::DOUBLE FROM range(10) t(i) ORDER BY i), window_size := 4);
----
true

query I
SELECT "index" = anomaly.motif_index(range(10)::DOUBLE[], 4)
FROM anomaly.motif_index((SELECT i::DOUBLE FROM range(10) t(i) ORDER BY i), window_size := 4);
----
true

query I
SELECT count(*) FROM anomaly.zscore_anomalies((SELECT 5.0 FROM range(20)));
----
0

# Invalid nonempty series give one NULL row; empty input gives no rows.
query I
SELECT "index" IS NULL FROM anomaly.zscore_anomalies((SELECT NULL::DOUBLE));
----
true

query I
SELECT count(*) FROM anomaly.change_points((SELECT 1.0 WHERE false));
----
0

# More than one output batch must be emitted without duplication or truncation.
query III
SELECT count(*), min("index"), max("index") FROM anomaly.zscore_anomalies(
  (SELECT CASE WHEN i % 2 = 0 THEN -1.0 ELSE 1.0 END FROM range(5000) t(i) ORDER BY i), threshold := 0.5);
----
5000	0	4999

statement error
SELECT * FROM anomaly.zscore_anomalies((SELECT 1.0), threshold := 0.0);
----

statement error
SELECT * FROM anomaly.change_points((SELECT 'bad'));
----

statement error
SELECT * FROM anomaly.change_points((SELECT 1.0, 2.0));
----

statement ok
DETACH anomaly;
